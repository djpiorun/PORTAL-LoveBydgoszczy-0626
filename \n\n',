    const insertBlock = (type: string) => {
      const blocks = {
        heading: "## ",
        quote: "> ",
        list: "* ",
        separator: "---",
        bold: "**",
        link: "[link](url)",
        code: "```\n",
      };
      const block = blocks[type];
      if (block) {
        set("content", form.content + block);
      }
    };

    const handleSave = async (statusOverride?: string) => {
      if (!form.title.trim()) { toast.error("Tytuł jest wymagany"); return; }
      if (!form.author.trim()) { toast.error("Autor jest wymagany"); return; }
      if (!form.content.trim()) { toast.error("Treść jest wymagana"); return; }

      setSaving(true);
      try {
        const payload: any = {
          title: form.title,
          excerpt: form.excerpt,
          content: form.content,
          category: form.category as any,
          imageUrl: form.imageUrl || undefined,
          author: form.author,
          coauthor: form.coauthor || undefined,
          publishedAt: form.publishedAt,
          featured: form.featured,
          isPatronage: form.isPatronage,
          tags: form.tags,
          hideInReels: form.hideInReels,
          personName: form.personName || undefined,
          sourceName: form.sourceName || undefined,
          sourceUrl: form.sourceUrl || undefined,
          expertQuote: form.expertQuote || undefined,
          articleType: form.articleType as any || undefined,
          status: (statusOverride ?? form.status) as any || undefined,
          layout: form.layout as any || undefined,
          partnerName: form.partnerName || undefined,
          partnerUrl: form.partnerUrl || undefined,
          partnerLogoUrl: form.partnerLogoUrl || undefined,
          seoTitle: form.seoTitle || undefined,
          seoDescription: form.seoDescription || undefined,
          allowComments: form.allowComments,
          showUpdates: form.showUpdates,
        };

        if (article?._id) {
          await updateArticle({ id: article._id, ...payload });
          toast.success("Artykuł zaktualizowany!");
          onSave?.(article._id);
        } else {
          const id = await createArticle(payload);
          toast.success("Artykuł zapisany!");
          onSave?.(id);
        }
      } catch (e: any) {
        toast.error(e.message ?? "Błąd zapisu");
      } finally {
        setSaving(false);
      }
    };

    const statusConfig: Record<string, { label: string; color: string; icon: any }> = {
      draft: { label: "Szkic", color: "bg-slate-100 text-slate-700", icon: Lock },
      published: { label: "Opublikowany", color: "bg-green-100 text-green-700", icon: Globe },
      scheduled: { label: "Zaplanowany", color: "bg-blue-100 text-blue-700", icon: Clock },
      archived: { label: "Zarchiwizowany", color: "bg-orange-100 text-orange-700", icon: Archive },
    };

    const currentStatus = statusConfig[form.status ?? "draft"];
    const StatusIcon = currentStatus.icon;

    return (
      <div className="flex flex-col h-full min-h-screen bg-slate-50">
        {/* Top Bar */}
        <div className="sticky top-0 z-50 bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between gap-4 shadow-sm">
          <div className="flex items-center gap-3">
            <button onClick={onCancel} className="p-2 hover:bg-slate-100 rounded-lg transition-colors">
              <ArrowLeft className="w-5 h-5 text-slate-600" />
            </button>
            <div>
              <h1 className="font-black text-slate-900 text-lg leading-tight">
                {article?._id ? "Edytuj artykuł" : "Nowy artykuł"}
              </h1>
              <div className="flex items-center gap-2 mt-0.5">
                <span className={`inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full ${currentStatus.color}`}>
                  <StatusIcon className="w-3 h-3" />
                  {currentStatus.label}
                </span>
                {form.articleType && (
                  <span className="text-xs text-slate-400">
                    {ARTICLE_TYPES.find(t => t.value === form.articleType)?.label}
                  </span>
                )}
              </div>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={() => setPreviewMode(p => !p)}
              className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-semibold transition-colors ${previewMode ? 'bg-primary text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}`}
            >
              <Eye className="w-4 h-4" />
              <span className="hidden sm:inline">Podgląd</span>
            </button>
            <button
              onClick={() => handleSave("draft")}
              disabled={saving}
              className="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors disabled:opacity-50"
            >
              <Save className="w-4 h-4" />
              <span className="hidden sm:inline">Szkic</span>
            </button>
            <button
              onClick={() => handleSave("published")}
              disabled={saving}
              className="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-semibold bg-primary text-white hover:bg-primary/90 transition-colors disabled:opacity-50"
            >
              <Send className="w-4 h-4" />
              <span className="hidden sm:inline">{saving ? "Zapisuję..." : "Opublikuj"}</span>
            </button>
          </div>
        </div>

        <div className="flex flex-1 overflow-hidden">
          {/* Main Content */}
          <div className="flex-1 overflow-y-auto">
            <AnimatePresence mode="wait">
              {previewMode ? (
                <motion.div
                  key="preview"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  exit={{ opacity: 0 }}
                  className="max-w-3xl mx-auto px-6 py-10"
                >
                  <div className="bg-white rounded-3xl shadow-sm border border-slate-200 p-8">
                    <h1 className="text-4xl font-black text-slate-900 mb-4">{form.title || "Tytuł artykułu"}</h1>
                    <p className="text-xl text-slate-500 mb-6">{form.excerpt}</p>
                    {form.imageUrl && (
                      <img src={form.imageUrl} alt="" className="w-full h-64 object-cover rounded-2xl mb-6" />
                    )}
                    <div className="prose prose-slate max-w-none">
                      {form.content.split('\n').map((p, i) => <p key={i}>{p}</p>)}
                    </div>
                    {form.tags && form.tags.length > 0 && (
                      <div className="flex flex-wrap gap-2 mt-8 pt-6 border-t border-slate-100">
                        {form.tags.map(tag => (
                          <span key={tag} className="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-sm">#{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </motion.div>
              ) : (
                <motion.div
                  key="editor"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  exit={{ opacity: 0 }}
                  className="max-w-3xl mx-auto px-4 sm:px-6 py-8 space-y-6"
                >
                  {/* Title */}
                  <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <input
                      type="text"
                      value={form.title}
                      onChange={e => set("title", e.target.value)}
                      placeholder="Tytuł artykułu..."
                      className="w-full text-3xl font-black text-slate-900 placeholder:text-slate-300 border-none outline-none bg-transparent resize-none"
                    />
                    <textarea
                      value={form.excerpt}
                      onChange={e => set("excerpt", e.target.value)}
                      placeholder="Krótki opis / lead artykułu..."
                      rows={2}
                      className="w-full mt-3 text-lg text-slate-500 placeholder:text-slate-300 border-none outline-none bg-transparent resize-none"
                    />
                  </div>

                  {/* Image */}
                  <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <label className="block text-sm font-bold text-slate-700 mb-2">Zdjęcie główne (URL)</label>
                    <Input
                      value={form.imageUrl}
                      onChange={e => set("imageUrl", e.target.value)}
                      placeholder="https://..."
                      className="rounded-xl"
                    />
                    {form.imageUrl && (
                      <img src={form.imageUrl} alt="" className="mt-3 w-full h-48 object-cover rounded-xl" />
                    )}
                  </div>

                  {/* Block Toolbar */}
                  <div className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
                    <p className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Wstaw blok</p>
                    <div className="flex flex-wrap gap-2">
                      {[
                        { type: "heading", icon: Type, label: "Nagłówek" },
                        { type: "quote", icon: Quote, label: "Cytat" },
                        { type: "list", icon: List, label: "Lista" },
                        { type: "separator", icon: Minus, label: "Separator" },
                        { type: "bold", icon: Type, label: "Pogrubienie" },
                        { type: "link", icon: Link2, label: "Link" },
                        { type: "code", icon: Code, label: "Kod" },
                      ].map(b => (
                        <button
                          key={b.type}
                          onClick={() => insertBlock(b.type)}
                          className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-600 text-xs font-semibold transition-colors border border-slate-200"
                        >
                          <b.icon className="w-3.5 h-3.5" />
                          {b.label}
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* Content */}
                  <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div className="px-4 py-2 border-b border-slate-100 bg-slate-50 flex items-center gap-2">
                      <FileText className="w-4 h-4 text-slate-400" />
                      <span className="text-xs font-bold text-slate-500 uppercase tracking-wider">Treść artykułu</span>
                      <span className="ml-auto text-xs text-slate-400">{form.content.length} znaków</span>
                    </div>
                    <textarea
                      ref={contentRef}
                      value={form.content}
                      onChange={e => set("content", e.target.value)}
                      placeholder="Zacznij pisać treść artykułu... Możesz używać Markdown: **pogrubienie**, *kursywa*, ## nagłówek, > cytat"
                      rows={20}
                      className="w-full p-6 text-slate-700 leading-relaxed outline-none resize-none font-mono text-sm bg-white"
                    />
                  </div>

                  {/* Source / Expert (for medyczna) */}
                  {form.category === "medyczna" && (
                    <div className="bg-teal-50 rounded-2xl border border-teal-200 p-6 shadow-sm">
                      <h3 className="font-black text-teal-800 mb-4">Źródło i ekspert (Medyczna)</h3>
                      <div className="space-y-3">
                        <Input value={form.sourceName} onChange={e => set("sourceName", e.target.value)} placeholder="Nazwa źródła" className="rounded-xl" />
                        <Input value={form.sourceUrl} onChange={e => set("sourceUrl", e.target.value)} placeholder="URL źródła" className="rounded-xl" />
                        <Textarea value={form.expertQuote} onChange={e => set("expertQuote", e.target.value)} placeholder="Cytat eksperta" rows={3} className="rounded-xl" />
                      </div>
                    </div>
                  )}

                  {/* Bydgoszczanie person */}
                  {form.category === "bydgoszczanie" && (
                    <div className="bg-rose-50 rounded-2xl border border-rose-200 p-6 shadow-sm">
                      <h3 className="font-black text-rose-800 mb-4">Osoba (Bydgoszczanie)</h3>
                      <Input value={form.personName} onChange={e => set("personName", e.target.value)} placeholder="Imię i nazwisko osoby" className="rounded-xl" />
                    </div>
                  )}
                </motion.div>
              )}
            </AnimatePresence>
          </div>

          {/* Sidebar */}
          <div className="w-80 shrink-0 border-l border-slate-200 bg-white overflow-y-auto hidden lg:block">
            <Tabs value={activeTab} onValueChange={setActiveTab}>
              <TabsList className="w-full rounded-none border-b border-slate-200 bg-slate-50 h-auto p-0">
                <TabsTrigger value="content" className="flex-1 rounded-none py-3 text-xs font-bold data-[state=active]:bg-white data-[state=active]:shadow-none border-b-2 border-transparent data-[state=active]:border-primary">
                  <Settings className="w-3.5 h-3.5 mr-1" />
                  Publikacja
                </TabsTrigger>
                <TabsTrigger value="appearance" className="flex-1 rounded-none py-3 text-xs font-bold data-[state=active]:bg-white data-[state=active]:shadow-none border-b-2 border-transparent data-[state=active]:border-primary">
                  <Palette className="w-3.5 h-3.5 mr-1" />
                  Wygląd
                </TabsTrigger>
                <TabsTrigger value="extra" className="flex-1 rounded-none py-3 text-xs font-bold data-[state=active]:bg-white data-[state=active]:shadow-none border-b-2 border-transparent data-[state=active]:border-primary">
                  <Plus className="w-3.5 h-3.5 mr-1" />
                  Dodatkowe
                </TabsTrigger>
              </TabsList>

              {/* Publication Tab */}
              <TabsContent value="content" className="p-4 space-y-5 mt-0">
                <SidebarSection title="Status">
                  <Select value={form.status ?? "draft"} onValueChange={v => set("status", v)}>
                    <SelectTrigger className="rounded-xl">
                      <SelectValue />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="draft">Szkic</SelectItem>
                      <SelectItem value="published">Opublikowany</SelectItem>
                      <SelectItem value="scheduled">Zaplanowany</SelectItem>
                      <SelectItem value="archived">Zarchiwizowany</SelectItem>
                    </SelectContent>
                  </Select>
                </SidebarSection>

                <SidebarSection title="Kategoria">
                  <Select value={form.category} onValueChange={v => set("category", v)}>
                    <SelectTrigger className="rounded-xl">
                      <SelectValue />
                    </SelectTrigger>
                    <SelectContent>
                      {CATEGORIES.map(c => (
                        <SelectItem key={c.value} value={c.value}>{c.label}</SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </SidebarSection>

                <SidebarSection title="Typ artykułu">
                  <div className="grid grid-cols-2 gap-2">
                    {ARTICLE_TYPES.map(t => {
                      const Icon = t.icon;
                      return (
                        <button
                          key={t.value}
                          onClick={() => set("articleType", t.value)}
                          className={`flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold border transition-colors ${form.articleType === t.value ? 'bg-primary text-white border-primary' : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100'}`}
                        >
                          <Icon className="w-3.5 h-3.5" />
                          {t.label}
                        </button>
                      );
                    })}
                  </div>
                </SidebarSection>

                <SidebarSection title="Autor">
                  <Input value={form.author} onChange={e => set("author", e.target.value)} placeholder="Autor" className="rounded-xl mb-2" />
                  <Input value={form.coauthor} onChange={e => set("coauthor", e.target.value)} placeholder="Współautor (opcjonalnie)" className="rounded-xl" />
                </SidebarSection>

                <SidebarSection title="Data publikacji">
                  <Input
                    type="datetime-local"
                    value={new Date(form.publishedAt).toISOString().slice(0, 16)}
                    onChange={e => set("publishedAt", new Date(e.target.value).getTime())}
                    className="rounded-xl"
                  />
                </SidebarSection>

                <SidebarSection title="Tagi">
                  <div className="flex gap-2 mb-2">
                    <Input
                      value={tagInput}
                      onChange={e => setTagInput(e.target.value)}
                      onKeyDown={e => e.key === "Enter" && (e.preventDefault(), addTag())}
                      placeholder="Dodaj tag..."
                      className="rounded-xl flex-1"
                    />
                    <button onClick={addTag} className="px-3 py-2 bg-primary text-white rounded-xl text-sm font-bold hover:bg-primary/90">
                      <Plus className="w-4 h-4" />
                    </button>
                  </div>
                  <div className="flex flex-wrap gap-1.5">
                    {form.tags?.map(tag => (
                      <span key={tag} className="inline-flex items-center gap-1 bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full text-xs font-medium">
                        #{tag}
                        <button onClick={() => removeTag(tag)} className="hover:text-red-500 transition-colors">×</button>
                      </span>
                    ))}
                  </div>
                </SidebarSection>

                <SidebarSection title="Opcje">
                  <div className="space-y-3">
                    <div className="flex items-center justify-between">
                      <Label className="text-sm font-semibold text-slate-700">Wyróżniony</Label>
                      <Switch checked={form.featured ?? false} onCheckedChange={v => set("featured", v)} />
                    </div>
                    <div className="flex items-center justify-between">
                      <Label className="text-sm font-semibold text-slate-700">Patronat</Label>
                      <Switch checked={form.isPatronage ?? false} onCheckedChange={v => set("isPatronage", v)} />
                    </div>
                    <div className="flex items-center justify-between">
                      <Label className="text-sm font-semibold text-slate-700">Ukryj w Reels</Label>
                      <Switch checked={form.hideInReels ?? false} onCheckedChange={v => set("hideInReels", v)} />
                    </div>
                    <div className="flex items-center justify-between">
                      <Label className="text-sm font-semibold text-slate-700">Komentarze</Label>
                      <Switch checked={form.allowComments ?? true} onCheckedChange={v => set("allowComments", v)} />
                    </div>
                    <div className="flex items-center justify-between">
                      <Label className="text-sm font-semibold text-slate-700">Oś aktualizacji</Label>
                      <Switch checked={form.showUpdates ?? false} onCheckedChange={v => set("showUpdates", v)} />
                    </div>
                  </div>
                </SidebarSection>
              </TabsContent>

              {/* Appearance Tab */}
              <TabsContent value="appearance" className="p-4 space-y-5 mt-0">
                <SidebarSection title="Układ artykułu">
                  <div className="space-y-2">
                    {LAYOUTS.map(l => (
                      <button
                        key={l.value}
                        onClick={() => set("layout", l.value)}
                        className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold border transition-colors ${form.layout === l.value ? 'bg-primary text-white border-primary' : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100'}`}
                      >
                        <div className={`w-8 h-5 rounded border-2 ${form.layout === l.value ? 'border-white/50' : 'border-slate-300'} flex items-center justify-center`}>
                          <div className={`h-2 rounded-sm bg-current ${l.value === 'standard' ? 'w-4' : l.value === 'wide' ? 'w-6' : 'w-7'}`} />
                        </div>
                        {l.label}
                      </button>
                    ))}
                  </div>
                </SidebarSection>

                <SidebarSection title="SEO">
                  <div className="space-y-3">
                    <div>
                      <Label className="text-xs font-bold text-slate-500 mb-1 block">Tytuł SEO</Label>
                      <Input value={form.seoTitle} onChange={e => set("seoTitle", e.target.value)} placeholder="Tytuł dla wyszukiwarek..." className="rounded-xl" />
                    </div>
                    <div>
                      <Label className="text-xs font-bold text-slate-500 mb-1 block">Opis SEO</Label>
                      <Textarea value={form.seoDescription} onChange={e => set("seoDescription", e.target.value)} placeholder="Opis dla wyszukiwarek..." rows={3} className="rounded-xl" />
                    </div>
                  </div>
                </SidebarSection>
              </TabsContent>

              {/* Extra Tab */}
              <TabsContent value="extra" className="p-4 space-y-5 mt-0">
                <SidebarSection title="Partner / Sponsor">
                  <div className="space-y-3">
                    <Input value={form.partnerName} onChange={e => set("partnerName", e.target.value)} placeholder="Nazwa partnera" className="rounded-xl" />
                    <Input value={form.partnerUrl} onChange={e => set("partnerUrl", e.target.value)} placeholder="Strona partnera" className="rounded-xl" />
                    <Input value={form.partnerLogoUrl} onChange={e => set("partnerLogoUrl", e.target.value)} placeholder="Logo partnera (URL)" className="rounded-xl" />
                    {form.partnerLogoUrl && (
                      <img src={form.partnerLogoUrl} alt="Logo" className="h-12 object-contain rounded-lg border border-slate-200 p-1" />
                    )}
                  </div>
                </SidebarSection>

                <SidebarSection title="Statystyki">
                  <div className="grid grid-cols-2 gap-3">
                    <div className="bg-slate-50 rounded-xl p-3 text-center">
                      <p className="text-2xl font-black text-slate-900">0</p>
                      <p className="text-xs text-slate-500 font-semibold">Wyświetleń</p>
                    </div>
                    <div className="bg-slate-50 rounded-xl p-3 text-center">
                      <p className="text-2xl font-black text-slate-900">0</p>
                      <p className="text-xs text-slate-500 font-semibold">Polubień</p>
                    </div>
                  </div>
                </SidebarSection>
              </TabsContent>
            </Tabs>
          </div>
        </div>
      </div>
    );
  }

  function SidebarSection({ title, children }: { title: string; children: React.ReactNode }) {
    const [open, setOpen] = useState(true);
    return (
      <div className="border border-slate-200 rounded-2xl overflow-hidden">
        <button
          onClick={() => setOpen(o => !o)}
          className="w-full flex items-center justify-between px-4 py-3 bg-slate-50 hover:bg-slate-100 transition-colors"
        >
          <span className="text-xs font-black text-slate-600 uppercase tracking-wider">{title}</span>
          {open ? <ChevronUp className="w-4 h-4 text-slate-400" /> : <ChevronDown className="w-4 h-4 text-slate-400" />}
        </button>
        <AnimatePresence>
          {open && (
            <motion.div
              initial={{ height: 0, opacity: 0 }}
              animate={{ height: "auto", opacity: 1 }}
              exit={{ height: 0, opacity: 0 }}
              transition={{ duration: 0.2 }}
              className="overflow-hidden"
            >
              <div className="p-4">{children}</div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    );
  }